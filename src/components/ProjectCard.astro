---
import Globe from "@lucide/astro/icons/globe";
import GitBranch from "@lucide/astro/icons/git-branch";
import type { Project } from "../lib/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="flex flex-col divide-y divide-zinc-400 dark:divide-zinc-500 overflow-hidden rounded ring-1 dark:zinc-500 dark:ring-zinc-500 ring-zinc-400">
  <div class="flex flex-wrap items-center justify-between gap-3 p-4">
    <h2 class="text-xl">{project.name}</h2>
    <Fragment set:html={project.technologies} />
  </div>
  <div class="grow">
    <p class="p-4">{project.description}</p>
  </div>
  <img
    src={project.imageUrl}
    width={1200}
    height={630}
    alt={`${project.name} preview`}
  />
  <div class="flex w-full justify-between divide-x divide-zinc-400 dark:divide-zinc-500">
    <a
      href={project.url}
      target="_blank"
      class="flex grow items-center justify-center gap-2 py-4 transition-transform sm:hover:bg-zinc-100 sm:dark:hover:bg-zinc-800"
    >
      <Globe class="size-5" stroke-width={1.4} /> Visit website
    </a>
    {project.githubUrl && (
      <a
        href={project.githubUrl}
        target="_blank"
        class="flex grow items-center justify-center gap-2 py-4 transition-transform sm:hover:bg-zinc-100 sm:dark:hover:bg-zinc-800"
      >
        <GitBranch class="size-5" stroke-width={1.4} /> View code
      </a>
    )}
  </div>
</div>
