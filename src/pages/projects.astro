---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../lib/projects";
---

<Layout>
  <h1 class="mb-16 mt-4 text-center text-5xl max-sm:text-4xl">Projects</h1>
  <div class="relative left-1/2 grid w-[min(64rem,calc(100vw-3rem))] -translate-x-1/2 gap-8 md:grid-cols-2">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</Layout>
