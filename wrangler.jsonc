{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lukeberrypi-blog",
  "account_id": "861e22f1e41ed20cb63c9f699ea8d1f5",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "lukeberrypi.com",
      "custom_domain": true
    },
    {
      "pattern": "www.lukeberrypi.com",
      "custom_domain": true
    }
  ]
}
